{
  "name": "@dropship/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && rm -f *.tsbuildinfo && tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only --watch src src/main.ts",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop dropship-api",
    "pm2:restart": "pm2 restart dropship-api",
    "pm2:logs": "pm2 logs dropship-api",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@dropship/types": "workspace:*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "groq-sdk": "^0.5.0",
    "nodemailer": "^7.0.12",
    "ollama": "^0.6.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
