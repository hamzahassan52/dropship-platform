{
  "name": "dropship-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered MCP server for dropshipping automation",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev:api": "turbo dev --filter=@dropship/api",
    "dev:web": "turbo dev --filter=@dropship/web",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
